{
  "name": "prototype-recorder-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "lsof -ti:3000,3001,3002 2>/dev/null | xargs kill -9 2>/dev/null; rm -rf .next && next dev",
    "build": "next build",
    "build:hostinger": "BUILD_TARGET=hostinger next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ptw/core": "0.1.0",
    "@ptw/engine-adapter": "0.1.0",
    "@ptw/job-contracts": "0.1.0",
    "@ptw/script-generator": "0.1.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.0"
  }
}
