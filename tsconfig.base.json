{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "declaration": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@ptw/job-contracts": ["packages/job-contracts/src/index.ts"],
      "@ptw/engine-adapter": ["packages/engine-adapter/src/index.ts"],
      "@ptw/script-generator": ["packages/script-generator/src/index.ts"]
    }
  }
}
