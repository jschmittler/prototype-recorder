# ─── Prototype Walkthrough — environment ───────────────────────────────
# Copy to .env for local development. The vertical-slice defaults run with
# fake adapters and in-memory infra, so the app runs with NO external services.

NODE_ENV=development
APP_MODE=demo                 # demo | hosted   (demo = no login, stricter limits)

# ─── Adapters (swap fakes for real in Phase 3) ─────────────────────────
AI_PROVIDER=fake              # fake | anthropic
EXECUTOR=fake                 # fake | local-process   (local-process runs the real engine)
# Path to a prototype-recorder-cli checkout/install (required when EXECUTOR=local-process).
ENGINE_DIR=
QUEUE_DRIVER=memory           # memory | redis
JOB_STORE=memory              # memory | postgres
STORAGE_DRIVER=local          # local | s3

# ─── Anthropic (required only when AI_PROVIDER=anthropic) ──────────────
# Keep server-side only; never expose to the browser.
ANTHROPIC_API_KEY=
# Verify the current model id in the Anthropic docs before production use.
ANTHROPIC_MODEL=claude-opus-4-8   # skill-recommended default; set a cheaper model if desired
ANTHROPIC_MAX_TOKENS=4096

# ─── Postgres (JOB_STORE=postgres) ─────────────────────────────────────
DATABASE_URL=postgresql://ptw:ptw@localhost:5432/ptw

# ─── Redis / BullMQ (QUEUE_DRIVER=redis) ───────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── S3 / MinIO (STORAGE_DRIVER=s3) ────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
# Endpoint used to sign browser download URLs. Set this when the app talks to
# S3/MinIO over an internal hostname the browser can't reach (e.g. in Docker,
# S3_ENDPOINT=http://minio:9000 but S3_PUBLIC_ENDPOINT=http://localhost:9000).
# Defaults to S3_ENDPOINT when unset.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=walkthroughs
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── Limits, retention, safety ─────────────────────────────────────────
JOB_RETENTION_HOURS=72
MAX_CONCURRENT_JOBS=2
MAX_RECORDING_SECONDS=150
MAX_JOB_RUNTIME_SECONDS=600
JOBS_PER_USER_PER_HOUR=20
JOBS_PER_IP_PER_HOUR=10
# Optional comma-separated host allowlist for enterprise deployments.
URL_ALLOWLIST=

# ─── Observability ─────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
