# ─── VPS production (single-server) ───────────────────────────────────
# Copy to .env in the repo root on your VPS, then: pm2 restart ptw

NODE_ENV=production
APP_MODE=hosted
PORT=3000
HOSTNAME=0.0.0.0

# Real recording (requires Playwright Chromium — installed by scripts/vps-setup.sh)
EXECUTOR=local-process
ENGINE_DIR=/opt/ptw/packages/recorder-cli

# Script generation (set your key for real AI scripts)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_MAX_OUTPUT_TOKENS=8000
OPENAI_REASONING_EFFORT=medium

# Single-server mode — no Postgres/Redis required for v1
JOB_STORE=memory
QUEUE_DRIVER=memory
STORAGE_DRIVER=local
STORAGE_DIR=/opt/ptw/storage

# Limits
MAX_CONCURRENT_JOBS=1
MAX_RECORDING_SECONDS=150
MAX_JOB_RUNTIME_SECONDS=600
JOBS_PER_IP_PER_HOUR=10
LOG_LEVEL=info
