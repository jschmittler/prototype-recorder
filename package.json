{
  "name": "prototype-recorder",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype Walkthrough — a SaaS app that turns a Figma prototype URL + plain-English brief into a polished walkthrough video, built on the prototype-recorder-cli recording engine.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build:hostinger -w prototype-recorder-web && node scripts/prepare-hostinger.mjs",
    "build:vps": "npm run build -w prototype-recorder-web",
    "start": "node hostinger-entry.cjs",
    "start:vps": "node scripts/vps-server.cjs",
    "lint": "eslint . || true",
    "format": "prettier --write .",
    "dev": "npm run dev -w prototype-recorder-web",
    "dev:clean": "npm run dev:clean -w prototype-recorder-web",
    "build:web": "npm run build -w prototype-recorder-web",
    "start:web": "npm run start -w prototype-recorder-web",
    "worker": "npm run start -w @ptw/worker",
    "db:generate": "npm run db:generate -w @ptw/core",
    "db:push": "npm run db:push -w @ptw/core",
    "stack:up": "docker compose up --build",
    "infra:up": "docker compose up -d postgres redis minio minio-init"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6",
    "zod": "^3.23.8"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "postcss@8.4.31": "^8.5.18",
    "sharp": "^0.35.0",
    "sharp@0.34.5": "^0.35.0",
    "esbuild": "^0.28.1",
    "esbuild@0.21.5": "^0.28.1",
    "vite": "^6.4.3",
    "vite@5.4.21": "^6.4.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.3": true
  }
}
